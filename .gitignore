# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/studio

# local raw cutouts for TR hero import (npm run tr:import-hero)
/tmp/tr-hero-raw/

# scratch/debug artifacts (untracked from git; kept on disk)
/.tmp-chrome-analysis/
/.tmp-chrome-recovered-meta.txt
/.tmp-chrome-recovery-notes.txt
/tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
