# Public site URL (magic-link redirects + auth callback)
NEXT_PUBLIC_SITE_URL=https://cortisstyle.com

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Branded boutique auth emails (OTP + password reset) via Resend
# From address must be on a verified Resend domain (e.g. noreply@cortisstyle.com)
RESEND_API_KEY=
# Optional alias used in some local setups:
# RESEND_API_KEY_PERVIN_SOYSAL_BUTIK=
AUTH_EMAIL_FROM="Cortisstyle <noreply@cortisstyle.com>"

# Custom SMTP — configure matching values in Supabase Dashboard → Auth → SMTP
# so default (non-boutique) magic-link emails send from noreply@cortisstyle.com
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=

# Impact (CJ / partner network) — homepage meta verification token
# IMPACT_SITE_VERIFICATION=your-token-from-impact-dashboard

# Launch gates (opt-in)
# NEXT_PUBLIC_MAINTENANCE_MODE=true

# TR marketplace — platform checkout (all boutiques). false = WhatsApp interim flow.
# next.config mirrors this to NEXT_PUBLIC_TR_CHECKOUT_ENABLED for Client Component SSR.
TR_CHECKOUT_ENABLED=false
# Or set the public flag explicitly (same effect):
# NEXT_PUBLIC_TR_CHECKOUT_ENABLED=false
